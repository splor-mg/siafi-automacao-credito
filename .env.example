# Copie para .env e preencha. O .env nunca vai para o Git.

# --- Acesso ao SIAFI ---
SISTEMA=
USUARIO=
SENHA=
UNIDADE_EXECUTORA=

# Pasta-raiz do robo de credito no OneDrive, vista de dentro do WSL. E a PASTA
# que contem 'Remanejamentos', 'Realizados', 'Robo' e 'Conferencia arquivo robo'.
# Sem aspas, mesmo com espacos no caminho.
ONEDRIVE_BASE=/mnt/c/Users/SEU_USUARIO/OneDrive - CAMG/.../Robo - Remanejamento de credito

# --- Opcionais ---
# false = roda sem a janela do x3270 (modo s3270). O bot do Telegram ja forca
# false por conta propria; isto vale para o duplo-clique no robo_credito.bat.
#SIAFI_VISIVEL=true

# Quantas vezes tentar conectar antes de desistir (VPN fora, sessao recusada).
#CONEXAO_TENTATIVAS=10
